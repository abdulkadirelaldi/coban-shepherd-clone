# Required
GEMINI_API_KEY=your_api_key_here

# Optional (defaults shown)
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is overloaded
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
# Leave empty to auto-detect, e.g. /dev/cu.usbmodem1101 (macOS) or COM3 (Windows)
SERIAL_PORT=
SERIAL_BAUDRATE=115200
ACK_TIMEOUT_SEC=10
# Do not move the robot if the model is less confident than this (0-1)
MIN_CONFIDENCE=0.6
CALIBRATION_FILE=calibration.json
# Approach height and table/grasp height in robot coordinates (mm)
SAFE_Z_MM=80
GRASP_Z_MM=10
# Where the arm waits after a DROP, outside the camera view (mm)
PARK_X_MM=0
PARK_Y_MM=30
# Closed loop: max model calls per task, and max consecutive failed steps before giving up
MAX_STEPS=12
MAX_RETRIES=3
# KVKK: pixelate faces before images are sent to the cloud or stored
BLUR_FACES=true
EPISODES_DIR=episodes
DEBUG_DIR=debug
